# Copy to .env and fill in. Never commit .env.

# Host
PUID=1000
PGID=1000
TZ=America/New_York

# Storage (passthrough data disk mounted in the VM)
DATA_ROOT=/mnt/data
MEDIA_ROOT=/mnt/data/Media

# Homepage: comma-separated hostnames/IPs allowed to load the dashboard
# Include your LAN IP and your Tailscale IP (tailscale ip -4)
HOMEPAGE_ALLOWED_HOSTS=<lan-ip>:3000,<tailscale-ip>:3000

# Speedtest Tracker: generate with `openssl rand -base64 32`, prefix with base64:
SPEEDTEST_APP_KEY=base64:<generated-key>

# RomM: generate secrets with `openssl rand -hex 32`
ROMM_AUTH_SECRET_KEY=<generated-secret>
ROMM_DB_PASSWORD=<strong-password>
ROMM_DB_ROOT_PASSWORD=<strong-password>
